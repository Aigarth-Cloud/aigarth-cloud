{
  "name": "@aigarth/config",
  "version": "0.1.0",
  "private": true,
  "description": "Shared configuration for the Aigarth monorepo — tsconfig presets, eslint, prettier.",
  "type": "module",
  "exports": {
    "./tsconfig/base.json": "./tsconfig/base.json",
    "./tsconfig/library.json": "./tsconfig/library.json",
    "./tsconfig/nextjs.json": "./tsconfig/nextjs.json",
    "./tsconfig/node.json": "./tsconfig/node.json",
    "./eslint": "./eslint/index.cjs",
    "./eslint/next": "./eslint/next.cjs",
    "./prettier": "./prettier/index.cjs",
    "./tailwind-preset": "./tailwind/preset.cjs"
  },
  "files": [
    "tsconfig",
    "eslint",
    "prettier",
    "tailwind"
  ],
  "scripts": {
    "lint": "echo \"@aigarth/config has no source to lint\" && exit 0",
    "typecheck": "echo \"@aigarth/config has no source to typecheck\" && exit 0",
    "clean": "rm -rf .turbo"
  },
  "dependencies": {
    "tailwindcss-animate": "^1.0.7"
  }
}
