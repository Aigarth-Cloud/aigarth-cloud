{
  "name": "@aigarth/sdk",
  "version": "0.2.0",
  "private": true,
  "description": "Aigarth Cloud SDK — typed, multi-service client (gateway + identity + qubic + compute + billing + ann + marketplace) with a CLI.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "aigarth": "./bin/aigarth.mjs"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./errors": {
      "types": "./dist/errors.d.ts",
      "import": "./dist/errors.js"
    },
    "./types": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/types/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js"
    }
  },
  "files": [
    "dist",
    "bin",
    "README.md"
  ],
  "scripts": {
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "clean": "rm -rf .turbo dist",
    "cli": "node ./bin/aigarth.mjs"
  },
  "dependencies": {},
  "devDependencies": {
    "@aigarth/config": "workspace:*",
    "@types/node": "^20.16.11",
    "typescript": "^5.6.2"
  }
}
