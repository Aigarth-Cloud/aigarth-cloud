# Aigarth Cloud — local development environment
# Copy to .env and edit. The .env file is gitignored.

# --- Core ---
AIGARTH_ENV=local
NODE_ENV=development

# --- PostgreSQL ---
POSTGRES_USER=aigarth
POSTGRES_PASSWORD=aigarth_dev
POSTGRES_DB=aigarth
POSTGRES_PORT=5432
DATABASE_URL=postgres://aigarth:aigarth_dev@localhost:5432/aigarth

# --- Redis ---
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# --- NATS (event bus) ---
NATS_PORT=4222
NATS_URL=nats://localhost:4222

# --- MinIO (S3-compatible object storage) ---
MINIO_ROOT_USER=aigarth
MINIO_ROOT_PASSWORD=aigarth_dev_secret
MINIO_PORT=9000
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=aigarth
S3_ACCESS_KEY=aigarth
S3_SECRET_KEY=aigarth_dev_secret

# --- MailHog (dev email) ---
MAILHOG_SMTP_PORT=1025
MAILHOG_WEB_PORT=8025
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=hello@aigarth.local

# --- Auth ---
JWT_SECRET=replace-me-with-a-real-secret-in-production
JWT_EXPIRES_IN=7d

# --- Gateway (Aigarth API) ---
AIGARTH_GATEWAY_URL=http://localhost:7000
AIGARTH_API_KEY=dev-only-key-replace-in-production

# --- Qubic (testnet defaults) ---
QUBIC_NETWORK=testnet
QUBIC_NODE_URL=https://testnet-rpc.qubic.org
QUBIC_TREASURY_SEED=

# --- Observability (Phase 13; noop locally) ---
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=
LOG_LEVEL=info
