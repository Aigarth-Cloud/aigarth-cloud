# Aigarth Cloud — production env template.
# This is committed as the EXAMPLE. The actual .env.production on the VPS is
# at /opt/aigarth/.env.production and is NOT committed.
#
# Generate the secrets with:
#   openssl rand -hex 32
# Or:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# Every value below must be replaced with a real production value before
# docker compose up.

# ---- Postgres ----
POSTGRES_USER=aigarth
POSTGRES_PASSWORD=__GENERATE_AND_PASTE_32_PLUS_CHARS__
POSTGRES_DB=aigarth

# ---- MinIO (S3-compatible object storage) ----
MINIO_ROOT_USER=aigarth
MINIO_ROOT_PASSWORD=__GENERATE_AND_PASTE_32_PLUS_CHARS__
S3_ENDPOINT=http://minio:9000
S3_BUCKET=aigarth-uploads

# ---- JWT (identity service) ----
# This secret signs every access + refresh token. Long, random, never rotated
# in public (rotating forces every user to re-login).
JWT_SECRET=__GENERATE_AND_PASTE_64_HEX_CHARS__
JWT_ISSUER=aigarth-identity
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# ---- Service-to-service internal token ----
# Every /v1/internal/* call uses this bearer token. The 12 services all read
# INTERNAL_TOKEN. Rotate via: update both identity and the caller, redeploy.
INTERNAL_TOKEN=__GENERATE_AND_PASTE_64_HEX_CHARS__

# ---- Work service (Phase 19C training) ----
WORK_SIGNING_KEY=__GENERATE_AND_PASTE_64_HEX_CHARS__
WORK_LEASE_DURATION_MS=30000
WORK_HEARTBEAT_INTERVAL_MS=5000
WORK_OFFLINE_AFTER_MS=30000
WORKER_DEFAULT_CONCURRENCY_CAP=2
WORKER_HARD_MAX_CONCURRENCY=5
REPUTATION_DECAY_MALICIOUS=0.1
REPUTATION_FLOOR=0.5
SCHEDULER_TICK_MS=5000
CHALLENGER_TICK_MS=60000
CHALLENGE_RATIO=0.01

# ---- Cross-service URLs (the apps and gateway read these) ----
# In Docker, services are reachable by their compose service name.
ANN_SERVICE_URL=http://ann:7006
BILLING_SERVICE_URL=http://billing:7005
MARKETPLACE_SERVICE_URL=http://marketplace:7007
GATEWAY_SERVICE_URL=http://gateway:7004
QUBIC_SERVICE_URL=http://qubic:7002
COMPUTE_SERVICE_URL=http://compute:7003
ECONOMY_SERVICE_URL=http://economy:7010
TRAINING_SERVICE_URL=http://training:7011
TISSUE_SERVICE_URL=http://tissue:7008
DATASET_SERVICE_URL=http://dataset:7009
IDENTITY_SERVICE_URL=http://identity:7001

# ---- CORS ----
# The identity service uses this for /v1/* CORS preflight. Comma-separated.
# The marketing site also reads CORS_ORIGINS in some places.
CORS_ORIGINS=https://aigarth.cloud,https://www.aigarth.cloud
COOKIE_SECURE=true

# ---- App base URLs ----
APP_BASE_URL=https://aigarth.cloud

# ---- AIO Qubic Dev Kit (opt-in profile; off by default) ----
TRAINING_COMPUTE_MODE=stub
