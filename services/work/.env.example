# Work service — copy to .env and edit.

NODE_ENV=development
PORT=7012
HOST=0.0.0.0
LOG_LEVEL=info

DATABASE_URL=postgres://aigarth:aigarth_dev@localhost:5432/aigarth

# JWT secret — must match identity, ann, tissue, and gateway services
JWT_SECRET=replace-me-with-the-same-secret-as-identity

# Cross-service URLs
ANN_SERVICE_URL=http://localhost:7006
BILLING_SERVICE_URL=http://localhost:7005

# Phase 18 closeout — internal service-to-service token. Must match
# the value identity and economy services are configured with.
INTERNAL_TOKEN=internal_dev_token_change_me

CORS_ORIGINS=*

# Phase 27 — HMAC-SHA-256 signing key for the work-item envelope
# and the algorithm container signature.
WORK_SIGNING_KEY=dev-only-rotate-before-prod-please-do-not-use-this-key

# Worker lease / heartbeat defaults (ADR 006 §5 + PEP §12).
WORK_LEASE_DURATION_MS=30000
WORK_HEARTBEAT_INTERVAL_MS=5000
WORK_OFFLINE_AFTER_MS=30000
WORKER_DEFAULT_CONCURRENCY_CAP=2
WORKER_HARD_MAX_CONCURRENCY=5
REPUTATION_DECAY_MALICIOUS=0.1
REPUTATION_FLOOR=0.5

# Scheduler polling interval.
SCHEDULER_TICK_MS=5000
CHALLENGER_TICK_MS=60000
CHALLENGE_RATIO=0.01
