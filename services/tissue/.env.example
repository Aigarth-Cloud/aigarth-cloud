# Tissue service — copy to .env and edit.

NODE_ENV=development
PORT=7008
HOST=0.0.0.0
LOG_LEVEL=info

DATABASE_URL=postgres://aigarth:aigarth_dev@localhost:5432/aigarth

# JWT secret — must match identity, ann, and gateway services
JWT_SECRET=replace-me-with-the-same-secret-as-identity

# Cross-service URLs
ANN_SERVICE_URL=http://localhost:7006
MARKETPLACE_SERVICE_URL=http://localhost:7007
BILLING_SERVICE_URL=http://localhost:7005

# Phase 18E — internal service-to-service tokens. Must match
# the values the marketplace and billing services are
# configured with.
MARKETPLACE_INTERNAL_TOKEN=dev-only-marketplace-internal-token-rotate-in-prod
BILLING_INTERNAL_TOKEN=dev-only-billing-internal-token-rotate-in-prod

CORS_ORIGINS=*

# Phase 18D — HMAC-SHA-256 signing key for the tissue-level envelope.
# v1: a single env-var key shared across all tissues in this service.
# v2: per-tissue keys loaded from a secrets manager.
TISSUE_SIGNING_KEY=dev-only-rotate-before-prod-please-do-not-use-this-key

# Per-tissue config
TISSUE_DEFAULT_AUTHORITY=0.5
TISSUE_MAX_MEMBERS=20
TISSUE_DECISION_TIMEOUT_MS=5000
