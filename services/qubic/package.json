{
  "name": "@aigarth/qubic",
  "version": "0.1.0",
  "private": true,
  "description": "Aigarth Qubic service — wallet reads, staking, transaction monitor, rewards, treasury.",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/index.ts",
    "build": "tsc",
    "start": "node --env-file=.env dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "echo \"lint not configured yet\" && exit 0",
    "test": "echo \"no tests yet\" && exit 0",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file=.env src/db/migrate.ts",
    "db:seed": "tsx --env-file=.env src/db/seed.ts",
    "worker:tx-monitor": "tsx --env-file=.env src/workers/tx-monitor.ts",
    "worker:rewards": "tsx --env-file=.env src/workers/rewards.ts",
    "worker:aigarthpool-watcher": "tsx --env-file=.env src/workers/aigarthpool-watcher.ts",
    "worker:qearn-watcher": "tsx --env-file=.env src/workers/qearn-watcher.ts",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "@aigarth/aigarthpool": "workspace:*",
    "@aigarth/config": "workspace:*",
    "@aigarth/observability": "workspace:*",
    "@aigarth/utils": "workspace:*",
    "@fastify/cookie": "^9.4.0",
    "@fastify/cors": "^9.0.1",
    "@fastify/helmet": "^11.1.1",
    "@fastify/jwt": "^8.0.1",
    "drizzle-orm": "^0.42.0",
    "fastify": "^4.28.1",
    "nats": "^2.28.0",
    "pg": "^8.13.1",
    "pino": "^9.5.0",
    "pino-pretty": "^11.3.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^20.16.11",
    "@types/pg": "^8.11.10",
    "drizzle-kit": "^0.30.0",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2"
  }
}
