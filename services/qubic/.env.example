# Qubic service — copy to .env and edit.

NODE_ENV=development
PORT=7002
HOST=0.0.0.0
LOG_LEVEL=info

DATABASE_URL=postgres://aigarth:aigarth_dev@localhost:5432/aigarth

# Identity service (for verifying user JWTs and creating stakes on their behalf)
IDENTITY_SERVICE_URL=http://localhost:7001
IDENTITY_SERVICE_TOKEN=

# JWT secret — must match the identity service
JWT_SECRET=replace-me-with-the-same-secret-as-identity

# Qubic network
QUBIC_NETWORK=testnet
QUBIC_NODE_URL=https://testnet-rpc.qubic.org
QUBIC_NODE_TIMEOUT_MS=10000

# Qubic RPC client implementation
# - "stub"   : in-memory mock with deterministic data (for local dev)
# - "http"   : HTTP gateway (for nodes that expose one)
# - "tcp"    : direct TCP to a Qubic node (requires qubic-tcp-client; not implemented yet)
QUBIC_CLIENT_MODE=stub

# Treasury wallet (multi-sig)
TREASURY_ADDRESS=
TREASURY_SEED=
TREASURY_THRESHOLD=3
TREASURY_SIGNERS=

# NATS (transaction monitor + reward worker)
NATS_URL=nats://localhost:4222
NATS_TX_SUBJECT=aigarth.qubic.tx
NATS_STAKE_SUBJECT=aigarth.qubic.stake

# Reward timing (Qubic epoch in seconds; configurable for testing)
QUBIC_EPOCH_SECONDS=604800
QUBIC_EPOCHS_PER_YEAR=52
QUBIC_TOTAL_SUPPLY_QUBIC=1000000000000

# Cooldowns (in Qubic epochs)
STAKE_COOLDOWN_EPOCHS=0
UNSTAKE_COOLDOWN_EPOCHS=1
