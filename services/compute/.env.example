# Compute service — copy to .env and edit.

NODE_ENV=development
PORT=7003
HOST=0.0.0.0
LOG_LEVEL=info

DATABASE_URL=postgres://aigarth:aigarth_dev@localhost:5432/aigarth

# JWT secret — must match the identity service
JWT_SECRET=replace-me-with-the-same-secret-as-identity

# Qubic service (for broadcasting jobs to computors)
QUBIC_SERVICE_URL=http://localhost:7002

# Job economics (illustrative — adjust in prod)
JOB_BASE_FEE_QUBIC=1000
JOB_COST_PER_MS_QUBIC=1
RESERVATION_FEE_BPS=50         # 0.5% reservation fee

# NATS (job monitor worker — subscribes to tx events)
NATS_URL=nats://localhost:4222
NATS_TX_SUBJECT=aigarth.qubic.tx
NATS_JOB_SUBJECT=aigarth.compute.job

# Capacity
DEFAULT_JOB_TIMEOUT_MS=30000
MAX_JOBS_PER_USER=100

CORS_ORIGINS=*
COOKIE_SECURE=false
