{
  "name": "@aigarth/compute",
  "version": "0.1.0",
  "private": true,
  "description": "Aigarth compute orchestrator — brokers jobs onto Qubic computors, manages capacity reservations and region/cluster topology.",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/index.ts",
    "build": "tsc",
    "start": "node --env-file=.env dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "echo \"lint not configured yet\" && exit 0",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file=.env src/db/migrate.ts",
    "db:seed": "tsx --env-file=.env src/db/seed.ts",
    "worker:job-monitor": "tsx --env-file=.env src/workers/job-monitor.ts",
    "worker:usd-price-oracle": "tsx --env-file=.env src/workers/usd-price-oracle.ts",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "@aigarth/config": "workspace:*",
    "@aigarth/observability": "workspace:*",
    "@aigarth/utils": "workspace:*",
    "@fastify/cookie": "^9.4.0",
    "@fastify/cors": "^9.0.1",
    "@fastify/helmet": "^11.1.1",
    "@fastify/jwt": "^8.0.1",
    "drizzle-orm": "^0.42.0",
    "fastify": "^4.28.1",
    "nats": "^2.28.0",
    "pg": "^8.13.1",
    "pino": "^9.5.0",
    "pino-pretty": "^11.3.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.16.11",
    "@types/pg": "^8.11.10",
    "drizzle-kit": "^0.30.0",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2",
    "vitest": "^2.1.9"
  }
}
