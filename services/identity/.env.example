# Identity service — copy to .env and edit.

NODE_ENV=development
PORT=7001
HOST=0.0.0.0
LOG_LEVEL=info

DATABASE_URL=postgres://aigarth:aigarth_dev@localhost:5432/aigarth

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace-me-with-a-32-byte-hex-secret-in-production
JWT_ISSUER=aigarth-identity
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# Argon2id parameters (OWASP recommended baseline)
ARGON2_MEMORY_KIB=19456
ARGON2_ITERATIONS=2
ARGON2_PARALLELISM=1

SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=hello@aigarth.local

CORS_ORIGINS=http://localhost:3003,http://localhost:4000
COOKIE_SECURE=false

# Service-to-service token (must match the value in callers like
# services/economy, services/training). Rotate before non-dev.
INTERNAL_TOKEN=internal_dev_token_change_me
