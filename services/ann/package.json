{
  "name": "@aigarth/ann",
  "version": "0.1.0",
  "private": true,
  "description": "Aigarth ANN Platform — registry, versioning, licensing, deployment, ratings, marketplace.",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/index.ts",
    "build": "tsc",
    "start": "node --env-file=.env dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "echo \"lint not configured yet\" && exit 0",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:integration": "vitest run --config vitest.config.integration.ts",
    "test:integration:dev": "cross-env INTEGRATION_DB_MODE=postgres vitest run --config vitest.config.integration.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file=.env src/db/migrate.ts",
    "db:seed": "tsx --env-file=.env src/db/seed.ts",
    "db:seed-anns": "tsx --env-file=.env src/db/seed-anns.ts",
    "db:seed-btc": "tsx --env-file=.env src/db/seed-btc-direction-predictor.ts",
    "clean": "node scripts/clean.mjs"
  },
  "dependencies": {
    "@aigarth/aigarthpool": "workspace:*",
    "@aigarth/config": "workspace:*",
    "@aigarth/observability": "workspace:*",
    "@aigarth/trinary": "workspace:*",
    "@aigarth/utils": "workspace:*",
    "@fastify/cookie": "^9.4.0",
    "@fastify/cors": "^9.0.1",
    "@fastify/helmet": "^11.1.1",
    "@fastify/jwt": "^8.0.1",
    "drizzle-orm": "^0.42.0",
    "fastify": "^4.28.1",
    "pg": "^8.13.1",
    "pino": "^9.5.0",
    "pino-pretty": "^11.3.0",
    "zod": "~3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.16.11",
    "@types/pg": "^8.11.10",
    "@vitest/coverage-v8": "^2.1.2",
    "cross-env": "^10.1.0",
    "drizzle-kit": "^0.30.0",
    "pg-mem": "^3.0.14",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2",
    "vitest": "^2.1.2"
  }
}
