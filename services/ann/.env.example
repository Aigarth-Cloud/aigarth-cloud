# ANN service — copy to .env and edit.

NODE_ENV=development
PORT=7006
HOST=0.0.0.0
LOG_LEVEL=info

DATABASE_URL=postgres://aigarth:aigarth_dev@localhost:5432/aigarth

# JWT secret — must match identity service
JWT_SECRET=replace-me-with-the-same-32-byte-hex-secret-as-identity

# Cross-service URLs
IDENTITY_SERVICE_URL=http://localhost:7001
QUBIC_SERVICE_URL=http://localhost:7002
COMPUTE_SERVICE_URL=http://localhost:7003
GATEWAY_SERVICE_URL=http://localhost:7004
BILLING_SERVICE_URL=http://localhost:7005

CORS_ORIGINS=*
COOKIE_SECURE=false

# ANN platform config
ANN_DEFAULT_LICENSE_SLUG=open
ANN_MAX_VERSIONS_PER_ANN=200
ANN_DEFAULT_REPLICAS=1

# Phase 18B — HMAC-SHA-256 signing key for the trinary protocol.
# v1: a single key shared across all ANNs in this service. v2 will
# use per-ANN keys loaded from a secrets manager.
# Must be at least 16 characters. Rotate before production.
ANN_TRINARY_SIGNING_KEY=dev-only-rotate-before-prod-please-do-not-use-this-key

# Phase 19C.3 — trinary model backend.
# `stub`              : deterministic hash backend, no model required (default)
# `openai_compatible` : any OpenAI-shaped chat-completions server
ANN_LLM_BACKEND=stub

# Phase 19C.3 — OpenAI-compatible backend config.
# Only used when ANN_LLM_BACKEND=openai_compatible.
# Examples:
#   OpenAI    : https://api.openai.com/v1, model=gpt-4o-mini
#   Ollama    : http://localhost:11434/v1, model=llama3.1
#   LM Studio : http://localhost:1234/v1, model=any
#   vLLM      : http://localhost:8000/v1, model=meta-llama/Llama-3.1-8B-Instruct
ANN_LLM_BASE_URL=http://localhost:11434/v1
ANN_LLM_MODEL=llama3.1
ANN_LLM_API_KEY=
ANN_LLM_TIMEOUT_MS=8000
ANN_LLM_MAX_TOKENS=512
ANN_LLM_TEMPERATURE=0.0
