# Economy service — copy to .env and edit.

NODE_ENV=development
PORT=7010
HOST=0.0.0.0
LOG_LEVEL=info

DATABASE_URL=postgres://aigarth:aigarth_dev@localhost:5432/aigarth

# JWT secret — must match identity service
JWT_SECRET=replace-me-with-the-same-secret-as-identity

# Cross-service URLs
IDENTITY_SERVICE_URL=http://localhost:7001
QUBIC_SERVICE_URL=http://localhost:7002
COMPUTE_SERVICE_URL=http://localhost:7003
ANN_SERVICE_URL=http://localhost:7006
MARKETPLACE_SERVICE_URL=http://localhost:7007
BILLING_SERVICE_URL=http://localhost:7005

# Qearn (real address from registry; default is the stub placeholder)
QUBIC_QEARN_CONTRACT_ADDRESS=QEARNAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA
QEARN_LOCK_PROCEDURE_INDEX=1
QEARN_UNLOCK_PROCEDURE_INDEX=2

# Qearn watcher
QEARN_WATCHER_POLL_INTERVAL_MS=15000
QEARN_WATCHER_ENABLED=true

# Economy defaults
ECONOMY_PLATFORM_FEE_BPS=1000   # 10%
ECONOMY_DEFAULT_LOOKBACK_DAYS=7

# NATS (for cross-service events)
NATS_URL=nats://localhost:4222
NATS_ECONOMY_SUBJECT=aigarth.economy.payouts

# Service-to-service token (must match the value on services/identity).
# Used by settleRun() to call /v1/internal/wallets/by-user/:userId.
INTERNAL_TOKEN=internal_dev_token_change_me

CORS_ORIGINS=*
COOKIE_SECURE=false
