{
  "name": "@aigarth/billing",
  "version": "0.1.0",
  "private": true,
  "description": "Aigarth billing service — plans, subscriptions, usage-based metering, invoices, payments (Qubic + credits + stub fiat), coupons, credits.",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/index.ts",
    "build": "tsc",
    "start": "node --env-file=.env dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "echo \"lint not configured yet\" && exit 0",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file=.env src/db/migrate.ts",
    "db:seed": "tsx --env-file=.env src/db/seed.ts",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "@aigarth/config": "workspace:*",
    "@aigarth/observability": "workspace:*",
    "@aigarth/utils": "workspace:*",
    "@fastify/cookie": "^9.4.0",
    "@fastify/cors": "^9.0.1",
    "@fastify/helmet": "^11.1.1",
    "@fastify/jwt": "^8.0.1",
    "drizzle-orm": "^0.45.2",
    "fastify": "^4.28.1",
    "pg": "^8.23.0",
    "pino": "^9.5.0",
    "pino-pretty": "^11.3.0",
    "zod": "~3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.16.11",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.23.12",
    "typescript": "^5.6.2",
    "vitest": "^2.1.9"
  }
}
