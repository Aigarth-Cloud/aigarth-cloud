# Billing service — copy to .env and edit.

NODE_ENV=development
PORT=7005
HOST=0.0.0.0
LOG_LEVEL=info

DATABASE_URL=postgres://aigarth:aigarth_dev@localhost:5432/aigarth

# JWT secret — must match identity service
JWT_SECRET=replace-me-with-the-same-secret-as-identity

# Cross-service URLs
IDENTITY_SERVICE_URL=http://localhost:7001
QUBIC_SERVICE_URL=http://localhost:7002
COMPUTE_SERVICE_URL=http://localhost:7003
GATEWAY_SERVICE_URL=http://localhost:7004
ANN_SERVICE_URL=http://localhost:7006
TISSUE_SERVICE_URL=http://localhost:7008

# Qubic treasury address (for Qu payments; will broadcast via services/qubic)
TREASURY_ADDRESS=

# Billing defaults
BILLING_PERIOD_DAYS=30
BILLING_DEFAULT_PAYMENT_METHOD=qubic
INVOICE_DUE_DAYS=14
BILLING_GRACE_DAYS=3

CORS_ORIGINS=*
COOKIE_SECURE=false

# Phase 18E — internal service-to-service token. Must match the
# value the tissue service uses when POSTing to
# /v1/internal/tissue-usage.
BILLING_INTERNAL_TOKEN=dev-only-billing-internal-token-rotate-in-prod
