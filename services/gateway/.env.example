# Gateway service — copy to .env and edit.

NODE_ENV=development
PORT=7004
HOST=0.0.0.0
LOG_LEVEL=info

DATABASE_URL=postgres://aigarth:aigarth_dev@localhost:5432/aigarth

# JWT secret — must match identity service
JWT_SECRET=replace-me-with-the-same-secret-as-identity

# Identity service (for cross-service user lookups if needed)
IDENTITY_SERVICE_URL=http://localhost:7001
COMPUTE_SERVICE_URL=http://localhost:7003

# Phase 18C — ANN service. Used when a chat request sets
# `intent: "trinary"`. The gateway forwards the request to
# POST /v1/anns/:model/decide on this URL.
ANN_SERVICE_URL=http://localhost:7006

# Gateway pricing (illustrative — QUBIC per 1K tokens)
GATEWAY_CHAT_INPUT_COST_QUBIC=10
GATEWAY_CHAT_OUTPUT_COST_QUBIC=30
GATEWAY_EMBED_COST_QUBIC=1
GATEWAY_IMAGE_COST_QUBIC=100

# Phase 18C — flat fee per trinary decision. Trinary mode is
# priced per decision rather than per token because the
# response is a single IntentEnvelope, not a streamed text.
GATEWAY_TRINARY_DECISION_COST_QUBIC=5

# Default rate limits (per API key)
GATEWAY_RPM_LIMIT=60
GATEWAY_TPM_LIMIT=100000

# Token estimation
GATEWAY_AVG_CHARS_PER_TOKEN=4

CORS_ORIGINS=*
COOKIE_SECURE=false
