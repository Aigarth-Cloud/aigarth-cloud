# Dataset service — copy to .env and edit.

NODE_ENV=development
PORT=7009
HOST=0.0.0.0
LOG_LEVEL=info

DATABASE_URL=postgres://aigarth:aigarth_dev@localhost:5432/aigarth

# JWT secret — must match identity, ann, and gateway services.
JWT_SECRET=replace-me-with-the-same-32-byte-hex-secret-as-identity

CORS_ORIGINS=*
COOKIE_SECURE=false

# S3-compatible object storage (MinIO per infrastructure/docker-compose.yml).
# Default bucket is `aigarth`. The minio-init container creates it on first
# boot. Override here for production (R2, AWS S3, etc.).
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=aigarth
S3_ACCESS_KEY_ID=aigarth
S3_SECRET_ACCESS_KEY=aigarth_dev_secret
S3_FORCE_PATH_STYLE=true

# Upload limits
DATASET_MAX_UPLOAD_BYTES=1073741824
DATASET_SAMPLE_PEEK_BYTES=1048576

# Comma-separated list of user IDs (uuid) with admin powers in this service.
DATASET_ADMIN_USER_IDS=
