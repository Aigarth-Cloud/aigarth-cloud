# Marketplace service — copy to .env and edit.

NODE_ENV=development
PORT=7007
HOST=0.0.0.0
LOG_LEVEL=info

DATABASE_URL=postgres://aigarth:aigarth_dev@localhost:5432/aigarth

# JWT secret — must match identity service
JWT_SECRET=replace-me-with-the-same-32-byte-hex-secret-as-identity

# Cross-service URLs
IDENTITY_SERVICE_URL=http://localhost:7001
QUBIC_SERVICE_URL=http://localhost:7002
COMPUTE_SERVICE_URL=http://localhost:7003
GATEWAY_SERVICE_URL=http://localhost:7004
BILLING_SERVICE_URL=http://localhost:7005
ANN_SERVICE_URL=http://localhost:7006

CORS_ORIGINS=*
COOKIE_SECURE=false

# Marketplace config
MKT_MAX_OFFERS_PER_LISTING=200
MKT_DEFAULT_AUCTION_DURATION_HOURS=24
MKT_PLATFORM_FEE_BPS=250  # 2.5% platform fee
MKT_ADMIN_USER_IDS=

# Phase 18E — internal service-to-service token. Must match
# the value the tissue service uses when calling
# POST /v1/tissue-listings/:id/decisions.
MARKETPLACE_INTERNAL_TOKEN=dev-only-marketplace-internal-token-rotate-in-prod
